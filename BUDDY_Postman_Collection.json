              "raw": "{{baseUrl}}/languages/",
              "host": ["{{baseUrl}}"],
              "path": ["languages", ""]
            }
          }
        },
        {
          "name": "Get Interests List (with Emojis)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/interests/",
