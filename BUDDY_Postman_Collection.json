              "host": ["{{baseUrl}}"],
              "path": ["categories", "1", ""]
            }
          }
        },
        {
          "name": "Categories - Soft Delete Category (ADMIN Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
