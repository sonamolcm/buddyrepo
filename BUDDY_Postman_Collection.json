              "path": ["interests", ""]
            }
          }
        },
        {
          "name": "Categories - List All Active (Authenticated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ""]
            }
          }
        },
        {
          "name": "Categories - Get One by ID (Authenticated)",
          "request": {
            "method": "GET",
