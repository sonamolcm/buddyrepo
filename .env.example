# ==========================================
# BUDDY BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your real credentials
# ==========================================

# Django Security
SECRET_KEY=your-secure-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# MySQL Database Configuration (Local)
DB_NAME=buddy_db
DB_USER=root
DB_PASSWORD=12345
DB_HOST=127.0.0.1
DB_PORT=3306

# For PythonAnywhere MySQL, use:
# DB_NAME=buddy2026$buddy_db
# DB_USER=buddy2026
# DB_PASSWORD=your_pythonanywhere_mysql_password
# DB_HOST=buddy2026.mysql.pythonanywhere-services.com
# DB_PORT=3306

# OTP Provider Configuration
OTP_PROVIDER=DEV
OTP_EXPIRY_MINUTES=5
