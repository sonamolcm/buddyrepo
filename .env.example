# ==========================================
# BUDDY BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your real credentials
# ==========================================

# Django Security
SECRET_KEY=your-secure-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,buddy2026.pythonanywhere.com,.pythonanywhere.com

# Database
# Default: SQLite (db.sqlite3) - No external DB setup required

# OTP Provider Configuration
# Options: DEV (prints OTP to console), TWILIO, MSG91
OTP_PROVIDER=DEV
OTP_EXPIRY_MINUTES=5

# Agora RTC Settings
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Firebase Cloud Messaging (FCM) Settings
# Provide either a path to your serviceAccountKey.json or raw JSON string
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
