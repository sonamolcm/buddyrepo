        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Life Coach\",\n  \"description\": \"Personal life and motivation coaching\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", ""]
            },
            "description": "Creates a new category for agents."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Calls & Wallet",
      "item": [
        {
          "name": "List All Calls",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/calls/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calls", ""]
            },
            "description": "Returns call history and real-time call states."
          },
          "response": []
        },
        {
          "name": "Add / Recharge Coins",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+919876543210\",\n  \"coins\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coins/add/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coins", "add", ""]
            },
            "description": "Credits coins to user wallet and records a transaction."
          },
          "response": []
        },
        {
          "name": "Get Coin Purchase History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coins/history/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coins", "history", ""]
            },
            "description": "Returns user's coin purchase history with status, message at top, and purchases inside data."
          },
          "response": []
        },
        {
          "name": "Record Coin Purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coins\": 100,\n  \"price\": 99,\n  \"payment_id\": \"pay_123456\",\n  \"order_id\": \"ord_123456\",\n  \"description\": \"100 Coins Recharge\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coins/history/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coins", "history", ""]
            },
            "description": "Records a new coin purchase, credits wallet, and logs transaction."
          },
          "response": []
        },
        {
          "name": "List Agent Payout Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/agent/payouts/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agent", "payouts", ""]
            },
            "description": "Lists all agent coin withdrawal requests."
          },
          "response": []
        }
      ]
    }
  ]
